{
  // ==================== talk：滔滔链路连接（必填） ====================
  "talk": {
    "host": "totalkd.allptt.com",   // 滔滔链路服务器地址，默认即可
    "port": 59638,                  // TCP/TLS 协议端口，默认即可
    "use_tls": true,                // 是否启用 TLS 加密连接，建议 true
    "username": "YOUR_TALK_USERNAME", // 【必填】滔滔链路登录账号（你的用户ID/手机号）
    "password": "YOUR_TALK_PASSWORD", // 【必填】滔滔链路登录密码
    // client_profile：客户端画像——模拟成真实手机 App 登录的样子
    // 服务器会把这几项广播给频道其他成员（显示"某某手机在收听"），
    // 对齐真实手机能降低被识别为机器人/风控的概率。一般不用改。
    "client_profile": {
      "release": "V2.8.5",        // App 版本号
      "os_name": "Android",       // 操作系统
      "os_version": "16",         // 系统版本
      "model": "PKT110"           // 机型
    }
  },

  // ==================== tts：语音合成（Edge-TTS） ====================
  "tts": {
    "voice": "zh-CN-XiaoxiaoNeural", // 播报用的语音角色（微软晓晓），可换 zh-CN-YunxiNeural 等
    "timeout_inner": 28,             // 单次合成内部超时（秒）。比外层少2秒，确保线程一定能退出
    "timeout_join": 30,              // 外层等待线程结束的超时（秒）。合成卡死时兜底
    "max_retries": 3,                // 合成失败后重试次数（含首次共3次）
    "retry_delay": 5.0,              // 每次重试前的等待秒数
    "cache_expire_days": 2,          // TTS 音频缓存有效期（天）。过期后重新合成
    "prefill_hours": 48              // 蓄水池提前量（小时）：提前预合成未来48小时内所有
                                     // 播报时段的音频，准点播报不依赖当时网络
  },

  // ==================== announce：播报内容与时段 ====================
  "announce": {
    // 播报模板。支持占位符：
    //   {year} 年、{month} 月、{day} 日、{weekday} 星期、
    //   {hour} 时、{minute_text} 分（30会说"三十分"）
    // 正文请改成你自己的中继台呼号、下行/上行频率、叉频、亚音值
    "template": "CQ CQ CQ，现在是{year}年{month}月{day}日，{weekday}，{hour}点{minute_text}。这里是示例市业余无线电中继台B阿九AB，本中继下行频率 4三9.625 兆赫，上行频率 4三2.575 兆赫，叉频 负 7.05 兆赫。单上行接入亚音为模拟 88.5 赫兹。请规范用频，保持信道畅通。完毕",
    "start_hour": 7,   // 每日首次播报的整点小时（7=07:00 开始）
    "end_hour": 22     // 每日最后一次播报所在小时（22=最后播 22:30，之后不再播）
    // 播报节奏：start_hour ~ end_hour 之间每半小时播一次（XX:00 和 XX:30）
  },

  // ==================== test：测试模式（可选，等价于命令行 -t） ====================
  // 启用后启动时先连续播报 count 次（每次间隔2秒），然后自动进入正常调度循环。
  // 命令行 -t 显式指定时优先级高于本配置。生产环境保持 enabled=false。
  "test": {
    "enabled": false,   // true=启动即进入测试模式；false=正常定时调度
    "count": 1          // 测试模式连续播报次数（正整数）
  },

  // ==================== timing：直连播报时序（一般不用改） ====================
  "timing": {
    "native_prep_lead": 2.5,  // 准点前多少秒预建链路+登录（实测建链约1秒，留2.5秒余量）
    "native_mic_lead": 0.5,   // 准点前多少秒才抢麦。刻意不提前，避免频道里长时间显示"说话中"静默
    "lead_delay": 0.5,        // 上报开始说话(UserTalking) 到发首个语音包的间隔（秒）。
                              // 中继台设备靠这个间隔建立转发链路，太小会吞掉开头字
    "packet_period": 0.12,    // 每个语音包的发送间隔（秒），即120ms/包 = 官方实时编码节奏。
                              // 改成批突发会导致接收端卡顿丢字，建议保持默认
    "tail_flush": 0.3         // 最后一个语音包发出后、放麦前的"尾巴冲刷"时长（秒）。
                              // 调小(如0.1)可缩短播报结尾的空白，但过小可能截掉尾音
  },

  // ==================== audio：音频编码与裁剪 ====================
  "audio": {
    "opus_bitrate": 12000,    // Opus 编码码率（bps），12kbps 为对讲音质，改大会变清晰但更占带宽
    "trim_silence": true,     // 是否自动裁切音频头尾的静音（推荐 true）
    "trim_threshold": 200,    // 静音判定阈值：样本绝对值低于此值视为静音（200 适合 TTS 合成音）
    "trim_min_ms": 50         // 裁切时头尾各保留的余量（毫秒）。保留一点呼吸感，防止"字被切掉"
  },

  // ==================== paths：数据目录（Docker 内路径） ====================
  "paths": {
    "cache_dir": "/app/tts_cache",  // TTS 合成音频缓存目录（挂载到宿主机同名目录）
    "log_dir": "/app/logs"          // 运行日志目录
  },

  // ==================== logging：日志轮转 ====================
  "logging": {
    "max_bytes": 262144,   // 单个日志文件上限（字节），262144=0.25MB，写满后轮转
    "backup_count": 40     // 保留最近的日志备份份数（40份）
  },

  // ==================== notify：企业微信告警（可选） ====================
  "notify": {
    "webhook_url": "",     // 企业微信群机器人 Webhook 地址。
                           // 留空 = 禁用告警；填了则日志达到指定级别时推送到群里
    "webhook_log_level": "WARNING"  // 触发推送的最低日志级别：
                                    // WARNING=仅告警+错误；ERROR=仅错误；INFO=全部
  }
}

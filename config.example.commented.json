{
  // ==================== talk：滔滔链路连接（必填） ====================
  "talk": {
    "host": "totalkd.allptt.com",   // 滔滔链路服务器地址，默认即可
    "port": 59638,                  // TCP/TLS 协议端口，默认即可
    "use_tls": true,                // 是否启用 TLS 加密连接，建议 true
    "username": "YOUR_TALK_USERNAME", // 【必填】滔滔链路登录账号（你的用户ID/手机号）
    "password": "YOUR_TALK_PASSWORD", // 【必填】滔滔链路登录密码
    // client_profile：客户端画像——模拟成真实手机 App 登录的样子
    // 服务器会把这几项广播给频道其他成员（显示"某某手机在收听"），
    // 对齐真实手机能降低被识别为机器人/风控的概率。一般不用改。
    "client_profile": {
      "release": "V2.8.5",        // App 版本号
      "os_name": "Android",       // 操作系统
      "os_version": "16",         // 系统版本
      "model": "PKT110"           // 机型
    }
  },

  // ==================== tts：语音合成（Edge-TTS） ====================
  "tts": {
    "voice": "zh-CN-XiaoxiaoNeural", // 播报用的语音角色（微软晓晓），可换 zh-CN-YunxiNeural 等
    "timeout_inner": 28,             // 单次合成内部超时（秒）。比外层少2秒，确保线程一定能退出
    "timeout_join": 30,              // 外层等待线程结束的超时（秒）。合成卡死时兜底
    "max_retries": 3,                // 合成失败后重试次数（含首次共3次）
    "retry_delay": 5.0,              // 每次重试前的等待秒数
    "cache_expire_days": 2,          // TTS 音频缓存有效期（天）。过期后重新合成
    "prefill_hours": 48              // 蓄水池提前量（小时）：提前预合成未来48小时内所有
                                     // 播报时段的音频，准点播报不依赖当时网络
  },

  // ==================== announce：播报内容与时段 ====================
  "announce": {
    // 播报模板。支持占位符：
    //   {year} 年、{month} 月、{day} 日、{weekday} 星期、
    //   {hour} 时、{minute_text} 分（30会说"三十分"）
    // 正文请改成你自己的中继台呼号、下行/上行频率、叉频、亚音值
    "template": "CQ CQ CQ，现在是{year}年{month}月{day}日，{weekday}，{hour}点{minute_text}。这里是示例市业余无线电中继台B阿九AB，本中继下行频率 4三9.625 兆赫，上行频率 4三2.575 兆赫，叉频 负 7.05 兆赫。单上行接入亚音为模拟 88.5 赫兹。请规范用频，保持信道畅通。完毕",
    "start_hour": 7,   // 每日首次播报的整点小时（7=07:00 开始）
    "end_hour": 22     // 每日最后一次播报所在小时（22=最后播 22:30，之后不再播）
    // 播报节奏：start_hour ~ end_hour 之间每半小时播一次（XX:00 和 XX:30）
  },

  // ==================== test：测试模式（可选，等价于命令行 -t） ====================
  // 启用后启动时先连续播报 count 次（每次间隔2秒），然后自动进入正常调度循环。
  // 命令行 -t 显式指定时优先级高于本配置。生产环境保持 enabled=false。
  "test": {
    "enabled": false,   // true=启动即进入测试模式；false=正常定时调度
    "count": 1          // 测试模式连续播报次数（正整数）
  },

  // ==================== timing：直连播报时序（一般不用改） ====================
  "timing": {
    "native_prep_lead": 2.5,  // 准点前多少秒预建链路+登录（实测建链约1秒，留2.5秒余量）
    "native_mic_lead": 0.5,   // 准点前多少秒才抢麦。刻意不提前，避免频道里长时间显示"说话中"静默
    "lead_delay": 0.5,        // 上报开始说话(UserTalking) 到发首个语音包的间隔（秒）。
                              // 中继台设备靠这个间隔建立转发链路，太小会吞掉开头字
    "packet_period": 0.12,    // 每个语音包的发送间隔（秒），即120ms/包 = 官方实时编码节奏。
                              // 改成批突发会导致接收端卡顿丢字，建议保持默认
    "tail_flush": 0.3         // 最后一个语音包发出后、放麦前的"尾巴冲刷"时长（秒）。
                              // 调小(如0.1)可缩短播报结尾的空白，但过小可能截掉尾音
  },

  // ==================== audio：音频编码与裁剪 ====================
  "audio": {
    "opus_bitrate": 12000,    // Opus 编码码率（bps），12kbps 为对讲音质，改大会变清晰但更占带宽
    "trim_silence": true,     // 是否自动裁切音频头尾的静音（推荐 true）
    "trim_threshold": 200,    // 静音判定阈值：样本绝对值低于此值视为静音（200 适合 TTS 合成音）
    "trim_min_ms": 50         // 裁切时头尾各保留的余量（毫秒）。保留一点呼吸感，防止"字被切掉"
  },

  // ==================== paths：数据目录（Docker 内路径） ====================
  "paths": {
    "cache_dir": "/app/tts_cache",  // TTS 合成音频缓存目录（挂载到宿主机同名目录）
    "log_dir": "/app/logs"          // 运行日志目录
  },

  // ==================== logging：日志轮转 ====================
  "logging": {
    "max_bytes": 262144,   // 单个日志文件上限（字节），262144=0.25MB，写满后轮转
    "backup_count": 40     // 保留最近的日志备份份数（40份）
  },

  // ==================== notify：企业微信告警（可选） ====================
  "notify": {
    "webhook_url": "",     // 企业微信群机器人 Webhook 地址。
                           // 留空 = 禁用告警；填了则日志达到指定级别时推送到群里
    "webhook_log_level": "WARNING"  // 触发推送的最低日志级别：
                                    // WARNING=仅告警+错误；ERROR=仅错误；INFO=全部
  },

  // ==================== net_control：点名主播（可选，默认关闭） ====================
  // 功能：纯ASR + 本地状态机 + LLM信息提取（可选） + 独立TTS 的自动点名主持。
  // 接收侧复用常驻链路下行（Opus解码+VAD切段），播报与点名共享 busy 锁互斥；
  // 点名进行中会跳过整点播报。ASR 走阿里云百炼 qwen3-asr-flash（OpenAI兼容接口）。
  // 字母解释法呼号：ASR 带词表上下文 → 词表确定性解码 → 呼号格式校验 → 已抄收去重 →
  // 低置信度播报"请重复一遍呼号"（限次）。所有字段均可缺省，代码内置默认值兜底。
  "net_control": {
    "enabled": false,           // true=启用点名；false=完全不启动（默认，不影响播报）
    "weekday": [0],             // 点名日期：空[]=每天；[0]=周一（0=周一 ... 6=周日）
    "hour": 20,                 // 点名开始小时（24小时制）
    "minute": 0,                // 点名开始分钟
    // ---- 点名台网信息（话术模板的 {占位符} 来源，全部可缺省）----
    "net": {
      "net_name": "应急通讯演练台网点名",
      "repeater_call": "BR9AB",   // 中继台呼号
      "ctrl_call": "BI9BZW",      // 主控呼号
      "ctrl_phonetic": "Bravo India Nine Bravo Zulu Whiskey",  // 主控呼号解释法（TTS 读单词更稳）
      "main_qth": "咸阳市渭城区塔尔坡",
      "main_device": "泉盛K6",
      "main_antenna": "原机天线",
      "main_power": "5瓦",
      "frequency": "",            // 填了可拼进开场白（铜川变体示例见注释）
      "offset": "",
      "tone": ""
    },
    // ---- 话术模板（TTS 优化要点：呼号写解释法英文单词 {call_phonetic}；
    // 时间写"北京时间{time}"；频率/亚音/功率用中文单位；保留 CQ/Over/73）----
    // 动态占位符：{date}今天日期 {weekday}星期 {time}北京时间 {net_name} {repeater_call}
    // {ctrl_call} {ctrl_phonetic} {main_qth} {main_device} {main_antenna} {main_power}
    // {frequency} {offset} {tone} | 应答级：{call} {call_phonetic} {report} {n} {calls}
    "opening_text": "CQ CQ CQ，这里是{repeater_call}业余无线电中继台，现在是每周{weekday}晚{net_name}，我是今晚主控{ctrl_call}，今天是{date}，现在是北京时间{time}，我的QTH位于{main_qth}，所用设备{main_device}，{main_antenna}，{main_power}功率发射，现在开始台网点名，请抄收到信号的友台依次上台报告你的呼号、QTH、使用设备、天线、功率以及抄收到主控台的信号报告，这里是{ctrl_phonetic} {ctrl_call}，Over",
    // 铜川变体开场白（把 frequency/offset/tone 填上后，可整段替换 opening_text）：
    // "CQ CQ CQ，这里是{ctrl_phonetic} {ctrl_call}，现在是{net_name}时间，铜川业余无线电中继台所用频率{frequency}兆赫，下差{offset}兆赫，发射亚音{tone}赫兹，现在是北京时间{time}，请抄收到信号的友台报告你的呼号、QTH、使用设备、天线、功率以及抄收到主控台的信号报告，这里是{ctrl_phonetic} {ctrl_call}，Over"
    "listen_after_open_seconds": 60,  // 开放点名模式：最短收听窗口秒数（开场后至少听这么久）
    "max_net_seconds": 1800,          // 点名总时长（秒）上限，默认 1800=30 分钟。
                                      // 到点后不立即结束：若仍有人在点名，等其说完——
                                      // 连续 quiet_end_seconds 秒无任何应答才收尾
    "quiet_end_seconds": 10,          // 到点后连续多少秒无人上台 → 触发最终结束语（默认 10s）
    "grace_seconds": 300,             // 到点后的硬性宽限（秒）。防止持续有人讲话导致
                                      // 点名无限延长，宽限耗尽强制收尾（默认 300=5 分钟）
    "ack_text": "{call_phonetic}，这里是{ctrl_call}，抄收你的信号{report}，请报告您的QTH、使用设备、天线、功率以及抄收主控的信号报告。Over",
    "repeat_report_text": "抄收您的位置与设备信息，请再报一次您的呼号，Over",
    "info_ack_text": "抄收，{call_phonetic}，您说的是：{info}。是否正确？Over",  // 当前友台补充完信息（无呼号段归入后）：复诵其内容让友台确认（空段自动忽略不播报）
    "confirm_text": "抄收，{call_phonetic}，感谢确认，请下一位友台。Over",  // 友台短确认语（"正确/收到/确认"）后的收尾话术
    "correct_text": "抱歉，刚才抄收可能有误，请您再重复一遍，Over",  // 友台纠正（"不对/错了"）后请其重报
    "repeat_text": "{call_phonetic}，请重复一遍您的呼号。",
    "dup_text": "{call_phonetic} 已经抄收过，请下一位友台。",
    "no_reply_text": "无人应答，继续下一位。",
    "summary_text": "本次点名共抄收{n}位友台：{calls}。",
    "closing_text": "CQ CQ CQ，现在是北京时间{time}，{net_name}到此结束，我是本次主控{ctrl_call}，本次参与台网点名的共有{n}位友台，非常感谢各位友台积极参与，接下来各位友台可以自由通联，73！",
    // ---- 话音检测（VAD）----
    "vad_threshold": 800,       // 活动音能量阈值（16bit 样本 RMS；链路底噪大时调高）
    "silence_end_ms": 1000,     // 静音多少毫秒判定"对方说完了"（UserTalking 结束信令+延迟收尾优先于它）。中继台讲话停顿多，600ms 易断句，建议 1000~1500
    "ptt_release_delay_ms": 1000,  // PTT 抬起（talking=false）后延迟多少毫秒再收尾：中继台断续转发时避免"一句话没说完就断成两段"，窗口内有声音自动取消
    "min_segment_ms": 400,      // 短于此的语音段忽略（防误触发）
    "max_segment_ms": 15000,    // 单段最长（超过强制截断，防失控）
    "use_talking_gate": true,   // 说话信令门控：仅采集服务器广播了"开始讲话"的远端语音，
                                // 可过滤链路底噪误触发的假应答段。若 60s 内从未收到任何
                                // 说话信令（个别平台不下发）会自动降级为纯 VAD，不丢应答
    "asr_min_seconds": 1.0,     // 送 ASR 的最短音频（秒）。不足此长的段在内存里补静音
                                // 到该长度（规避接口对极短/空音频返回 400）
    // ---- 呼号解码 ----
    "callsign_regex": "^B[A-Z]\\d[A-Z]{1,3}$",  // 中国内地呼号一般结构；港澳台等可改
    "confidence_threshold": 60, // 置信度低于此值 → 请求重复
    "max_retry": 1,             // 每个应答最多请求重复几次
    "extra_vocab": [],          // 额外实体词（如本地区号习惯读法、常见昵称）
    // ---- 录音与日志（识别质量闭环）----
    "save_audio": true,         // 应答语音段落盘（WAV 16k 单声道，供复盘/调优词表）
    "audio_dir": "/app/net_records",  // 落盘目录（含识别摘要 summary_*.json）
    // ---- 固定名单模式（可选；开放点名请保持 false）----
    "roster_mode": false,       // true=按名单逐个点名；false=开放点名（参与者不可预知）
    "roster": [],               // 固定名单：["BH3XXX","BG9ABC", ...]
    "roster_call_text": "请{call_phonetic}回答。Over",
    "roster_call_timeout": 12,  // 固定名单模式：呼叫后等待应答秒数，超时跳过
    "roster_max_seconds": 1800, // 固定名单模式总时长上限（秒），超时跳过剩余名单
    // ---- ASR（阿里云百炼 qwen3-asr-flash）----
    "asr": {
      "api_key": "",            // 【启用点名时必填】百炼 API Key（sk-...）
      "model": "qwen3-asr-flash",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "enable_itn": true,       // 数字归一化："五九"→"59"（信号报告需要）
      "language": ""            // 留空=自动识别；确定中文可填 zh
    },
    // ---- LLM 信息提取（可选，默认关闭；主路径为词表确定性解码）----
    "llm": {
      "enabled": false,         // true=低置信度时调 LLM 修复/提取备注
      "api_key": "",            // 智谱 API Key
      "model": "glm-4.5-flash", // 免费模型
      "base_url": "https://open.bigmodel.cn/api/paas/v4"
    }
  }
}
